# ─────────────────────────────────────────────────────────────
#  ClearPath — environment variables
#  Copy this file to `.env.local` and fill in real values.
#  `.env.local` is git-ignored — NEVER commit real keys.
# ─────────────────────────────────────────────────────────────

# ─── Supabase (public) ───────────────────────────────────────
# Safe to expose to the browser. Row-Level Security protects the data.
# From: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ─── Supabase (secret — SERVER ONLY) ─────────────────────────
# NEVER prefix with NEXT_PUBLIC. NEVER send to the client.
# Bypasses RLS — used only by the seed script and trusted server ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Shared password assigned to local/demo seed accounts. Use a demo-only value.
SEED_DEMO_PASSWORD=replace-with-a-demo-password-at-least-12-characters
# Explicit safeguard required before the demo seed can create or update users.
SEED_DEMO_CONFIRM=seed-clearpath-demo

# Demo mode: enables one-click demo logins and "load sample copy" helpers.
# Set to "true" ONLY on a throwaway demo deployment — never a real one.
# When enabled, the /auth/demo route signs in seeded accounts using
# SEED_DEMO_PASSWORD, so that must also be set in the same environment.
NEXT_PUBLIC_DEMO_MODE=false

# ─── OpenAI (secret — SERVER ONLY) ──────────────────────────
OPENAI_API_KEY=replace-with-openai-api-key

# ─── App ─────────────────────────────────────────────────────
# Used for auth redirects and absolute links.
# Local: http://localhost:3000   |   Prod: your Vercel deployment URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── (Optional) Direct Postgres connection ───────────────────
# Only if a migration tool connects directly instead of the Supabase CLI.
# From: Supabase → Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
