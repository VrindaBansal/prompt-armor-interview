{
  "name": "clearpath",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "npm run check:markdown",
    "dev": "next dev",
    "prebuild": "npm run check:markdown",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run check:markdown",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "security:audit": "npm audit --audit-level=high",
    "seed": "node --env-file=.env.local seed/index.mjs",
    "check:markdown": "node scripts/check-markdown-policy.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.1",
    "openai": "^7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
